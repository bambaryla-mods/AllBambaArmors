<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Arcane abilities and energy pools on this mod's armor (abilities/ABILITY_MAP.md).
		Energy: Advanced Spacer medium = 100; Solar x1.25, Ultra x1.25 more, Kwazaari x1.25 more; light/medium/heavy x0.75/1/1.25.
		Each pool refills from empty in 200 seconds. Missing defs (Royalty-only prestige) are skipped quietly.
	-->

	<!-- flanker armor: spacer light, 75 energy -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="ABT_Apparel_AS_ReconArmor"]</xpath>
		<match Class="PatchOperationConditional">
			<xpath>Defs/ThingDef[defName="ABT_Apparel_AS_ReconArmor"]/comps</xpath>
			<match Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="ABT_Apparel_AS_ReconArmor"]/comps</xpath>
				<value>
					<li Class="VEF.Abilities.CompProperties_AbilitiesApparel">
						<abilities>
							<li>ABT_ShadowStrike</li>
						</abilities>
					</li>
					<li Class="AllBambaArmors.CompProperties_AbilityEnergy">
						<maxEnergy>75</maxEnergy>
						<regenPerSecond>0.375</regenPerSecond>
						<barColor>(0.3, 0.55, 0.95)</barColor>
					</li>
				</value>
			</match>
			<nomatch Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="ABT_Apparel_AS_ReconArmor"]</xpath>
				<value>
					<comps>
						<li Class="VEF.Abilities.CompProperties_AbilitiesApparel">
							<abilities>
								<li>ABT_ShadowStrike</li>
							</abilities>
						</li>
						<li Class="AllBambaArmors.CompProperties_AbilityEnergy">
							<maxEnergy>75</maxEnergy>
							<regenPerSecond>0.375</regenPerSecond>
							<barColor>(0.3, 0.55, 0.95)</barColor>
						</li>
					</comps>
				</value>
			</nomatch>
		</match>
	</Operation>

