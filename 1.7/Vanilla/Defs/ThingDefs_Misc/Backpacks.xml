<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="ABA_NoQualityWearableBase" ParentName="ApparelNoQualityBase" Abstract="True">
    <techLevel>Ultra</techLevel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
          <li MayRequire="Ludeon.RimWorld.Odyssey">Obsidian</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
      <recipeUsers Inherit="False">
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef Name="ABA_BackpackBase" ParentName="ABA_NoQualityWearableBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>2</drawSize>
    </graphicData>
    <comps>
      <li Class="CompProperties_Styleable" />
    </comps>
    <apparel>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
    </apparel>
    <statBases>
      <Flammability>0.2</Flammability>
      <Insulation_Cold>6</Insulation_Cold>
      <EquipDelay>0.50</EquipDelay>
    </statBases>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="ABA_BackpackBase">
    <defName>ABA_Backpack_Industrial</defName>
    <label>industrial backpack</label>
    <description>A sturdy backpack that distributes weight and increases the wearer's carrying capacity.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Backpacks/Industrial_Backpack_north</texPath>
    </graphicData>
    <apparel>
      <wornGraphicPath>Backpacks/Industrial_Backpack</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <wornGraphicData>
        <male>
          <scale>(1.3,1.3)</scale>
        </male>
        <female>
          <scale>(1.3,1.3)</scale>
        </female>
        <thin>
          <scale>(1.3,1.3)</scale>
        </thin>
        <hulk>
          <scale>(1.3,1.3)</scale>
        </hulk>
        <fat>
          <scale>(1.3,1.3)</scale>
        </fat>
        <renderUtilityAsPack>true</renderUtilityAsPack>
      </wornGraphicData>
    </apparel>
    <recipeMaker>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costStuffCount>120</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costList>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <equippedStatOffsets>
      <CarryingCapacity>20</CarryingCapacity>
      <VEF_MassCarryCapacity MayRequire="oskarpotocki.vanillafactionsexpanded.core">50</VEF_MassCarryCapacity>
    </equippedStatOffsets>
    <statBases>
      <Mass>1.0</Mass>
    </statBases>
  </ThingDef>

