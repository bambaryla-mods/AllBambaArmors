    <apparel>
      <wornGraphicPath>Backpacks/Ultra_Backpack</wornGraphicPath>
      <useWornGraphicMask>false</useWornGraphicMask>
      <wornGraphicData>
        <male>
          <scale>(1.3,1.3)</scale>
        </male>
        <female>
          <scale>(1.3,1.3)</scale>
        </female>
        <thin>
          <scale>(1.3,1.3)</scale>
        </thin>
