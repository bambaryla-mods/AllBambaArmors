        <male>
          <scale>(1.3,1.3)</scale>
        </male>
        <female>
          <scale>(1.3,1.3)</scale>
        </female>
        <thin>
          <scale>(1.3,1.3)</scale>
        </thin>
        <hulk>
          <scale>(1.3,1.3)</scale>
        </hulk>
        <fat>
          <scale>(1.3,1.3)</scale>
        </fat>
        <renderUtilityAsPack>true</renderUtilityAsPack>
