<Defs>

	<!-- ==================== Industrial Recon Armor ==================== -->

	<ThingDef ParentName="ArmorMachineableBase">
		<defName>ABT_Apparel_IND_ReconHelmet</defName>
		<label>light helmet</label>
		<description>Offers basic protection from the elements, gunfire and related shrapnel. Mainly utilized by support personnel. Should not be deployed against mechanized threats.</description>
		<techLevel>Industrial</techLevel>
		<tickerType>Normal</tickerType>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisites>
				<li>ABT_Research_IND_ReconArmor</li>
			</researchPrerequisites>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
		</recipeMaker>
		<graphicData>
			<texPath>IndustrialRecon/Industrial_Recon_Helmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<uiIconScale>1.3</uiIconScale>
		<statBases>
			<WorkToMake>18000</WorkToMake>
			<MaxHitPoints>110</MaxHitPoints>
			<Mass>1.2</Mass>
			<Flammability>0.5</Flammability>
			<ArmorRating_Sharp>0.85</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.35</ArmorRating_Blunt>
			<ArmorRating_Heat>0.4</ArmorRating_Heat>
			<Insulation_Cold>4</Insulation_Cold>
			<Insulation_Heat>1</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
		</statBases>
		<equippedStatOffsets>

		</equippedStatOffsets>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<tradeTags>
			<li>HiTechArmor</li>
		</tradeTags>
		<costList>
			<ComponentIndustrial>3</ComponentIndustrial>
			<Steel>40</Steel>
			<Plasteel>5</Plasteel>
			<DevilstrandCloth>10</DevilstrandCloth>
		</costList>
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>IndustrialRecon/Industrial_Recon_Helmet</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li></li>
			</tags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<soundWear>Wear_PowerArmor</soundWear>
			<soundRemove>Remove_PowerArmor</soundRemove>
		</apparel>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
		</thingSetMakerTags>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.9,0.9,0.9)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.33,0.33,0.33)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.65,0.65,0.65)</only>
				</li>
				<li>
					<weight>6</weight>
					<min>(0.3,0.3,0.3)</min>
					<max>(0.5,0.5,0.5)</max>
				</li>
			</options>
		</colorGenerator>
		<comps>
			<li Class="CompProperties_Biocodable" />
		</comps>
		<allowedArchonexusCount>1</allowedArchonexusCount>
	</ThingDef>

