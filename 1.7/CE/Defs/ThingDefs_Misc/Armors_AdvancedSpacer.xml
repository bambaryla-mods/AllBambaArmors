				<Crafting>10</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>FabricationBench</li>
			</recipeUsers>
		</recipeMaker>
		<graphicData>
			<texPath>SpacerRecon/spacer_recon_Helmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<uiIconScale>1.3</uiIconScale>
		<statBases>
			<WorkToMake>20000</WorkToMake>
			<MaxHitPoints>250</MaxHitPoints>
			<Mass>2</Mass>
			<Bulk>4</Bulk>
			<WornBulk>1</WornBulk>
			<NightVisionEfficiency_Apparel>0.8</NightVisionEfficiency_Apparel>
			<Flammability>0</Flammability>
			<ArmorRating_Sharp>15</ArmorRating_Sharp>
			<ArmorRating_Blunt>35</ArmorRating_Blunt>
			<ArmorRating_Heat>0.55</ArmorRating_Heat>
			<Insulation_Cold>10</Insulation_Cold>
			<Insulation_Heat>5</Insulation_Heat>
			<EquipDelay>2</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<AimingAccuracy>0.25</AimingAccuracy>
			<ToxicEnvironmentResistance>0.50</ToxicEnvironmentResistance>
			<SmokeSensitivity>-1</SmokeSensitivity>
			<HypoxiaResistance MayRequire="kentington.saveourship2">0.5</HypoxiaResistance>
			<DecompressionResistance MayRequire="kentington.saveourship2">0.5</DecompressionResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.6</VacuumResistance>
		</equippedStatOffsets>
		<thingCategories>
			<li>ApparelArmor</li>
		</thingCategories>
		<tradeTags>
			<li>HiTechArmor</li>
		</tradeTags>
		<costList>
			<ComponentSpacer>3</ComponentSpacer>
			<Steel>30</Steel>
			<Plasteel>30</Plasteel>
			<Hyperweave>10</Hyperweave>
		</costList>
		<apparel>
			<immuneToToxGasExposure>true</immuneToToxGasExposure>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>SpacerRecon/spacer_recon_Helmet</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li></li>
			</tags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<soundWear>Wear_PowerArmor</soundWear>
			<soundRemove>Remove_PowerArmor</soundRemove>
		</apparel>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
		</thingSetMakerTags>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.9,0.9,0.9)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.33,0.33,0.33)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.65,0.65,0.65)</only>
				</li>
				<li>
					<weight>6</weight>
					<min>(0.3,0.3,0.3)</min>
					<max>(0.5,0.5,0.5)</max>
				</li>
			</options>
		</colorGenerator>
		<comps>
			<li Class="CompProperties_Biocodable" />
			<li MayRequire="kentington.saveourship2">
				<compClass>SaveOurShip2.CompEVA</compClass>
			</li>
		</comps>
		<allowedArchonexusCount>1</allowedArchonexusCount>
	</ThingDef>

