<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <Excluded>
    <!-- VCS / IDE -->
    <exclude>.git</exclude>
    <exclude>.vs</exclude>
    <!-- AI tooling -->
    <exclude>.claude</exclude>
    <exclude>.codex</exclude>
    <exclude>.cursor</exclude>
    <exclude>.aider</exclude>
    <exclude>.windsurf</exclude>
    <exclude>.opencode</exclude>
    <exclude>.copilot</exclude>
    <exclude>AGENTS.md</exclude>
    <exclude>CLAUDE.md</exclude>
    <exclude>GEMINI.md</exclude>
    <!-- Publisher config itself -->
    <exclude>_PublisherPlus.xml</exclude>
    <!-- Dev-only content: ability spec, map and patch generator -->
    <exclude>abilities</exclude>
    <!-- Repo and player site, not part of the mod -->
    <exclude>.github</exclude>
    <exclude>.gitignore</exclude>
    <exclude>.vscode</exclude>
    <exclude>docs</exclude>
    <exclude>site</exclude>
    <exclude>README.md</exclude>
    <!-- Source (single backslash, PublisherPlus does not unescape) -->
    <exclude>Source</exclude>
  </Excluded>
</Configuration>
