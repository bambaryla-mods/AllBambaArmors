<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>ABT_NightEyesHediff</defName><hediffClass>HediffWithComps</hediffClass>
		<label>night eyes</label>
		<description>Low-light optics are active. Darkness no longer penalizes combat.</description>
		<isBad>false</isBad>
		<stages>
			<li>
				<statOffsets>
					<ShootingAccuracyOutdoorsDarkOffset MayRequire="Ludeon.RimWorld.Ideology">0.25</ShootingAccuracyOutdoorsDarkOffset>
					<ShootingAccuracyIndoorsDarkOffset MayRequire="Ludeon.RimWorld.Ideology">0.25</ShootingAccuracyIndoorsDarkOffset>
					<MeleeHitChanceOutdoorsDarkOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</MeleeHitChanceOutdoorsDarkOffset>
					<MeleeHitChanceIndoorsDarkOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</MeleeHitChanceIndoorsDarkOffset>
					<MeleeDodgeChanceOutdoorsDarkOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</MeleeDodgeChanceOutdoorsDarkOffset>
					<MeleeDodgeChanceIndoorsDarkOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</MeleeDodgeChanceIndoorsDarkOffset>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>5000~5000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>ABT_AegisVeilHediff</defName><hediffClass>HediffWithComps</hediffClass>
		<label>aegis veil</label>
		<description>A protective veil blocks all ranged attacks.</description>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>1200~1200</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
			<li Class="VEF.Hediffs.HediffCompProperties_Shield"><compClass>VEF.Hediffs.HediffComp_Shield</compClass><graphic><texPath>Other/ShieldBubble</texPath><drawSize>(2.7, 2.7)</drawSize><graphicClass>Graphic_Single</graphicClass><shaderType>TransparentPostLight</shaderType></graphic>
				<absorbAttackType>Ranged</absorbAttackType>
				<cannotUseAttackType>None</cannotUseAttackType>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>ABT_SprintSurgeHediff</defName><hediffClass>HediffWithComps</hediffClass>
		<label>sprint surge</label>
		<description>Movement assist is overdriven, doubling movement speed.</description>
		<isBad>false</isBad>
		<stages>
			<li>
				<statFactors>
					<MoveSpeed>2</MoveSpeed>
				</statFactors>
			</li>
		</stages>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>2500~2500</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
	</HediffDef>

	<HediffDef>
		<defName>ABT_InvisibilityHediff</defName><hediffClass>HediffWithComps</hediffClass>
		<label>cloaked</label>
		<description>The suit bends perception around the wearer, making them invisible to others.</description>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_Invisibility">
				<visibleToPlayer>true</visibleToPlayer>
			</li>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>2500~2500</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
		</comps>
	</HediffDef>

</Defs>





