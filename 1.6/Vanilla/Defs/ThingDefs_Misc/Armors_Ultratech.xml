	<!-- ==================== Ultra Armor ==================== -->

	<ThingDef ParentName="ArmorNonMachineableBase">
		<defName>ABT_Apparel_Ultra_Helmet</defName>
		<label>glitter helmet</label>
		<description>A helmet which is a part of the entire glitter armor set. It has no name in the rim, it does not exist in the rim, it's a myth. It's beyond an armored helmet; it temporarily fuses with the user to be able to perform tasks and protect the wearer. Protection offered by the set is unparalleled and unachievable for the common rimworlder.</description>
		<techLevel>Ultra</techLevel>
		<costList />
		<!-- <recipeMaker>
			<unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
			<researchPrerequisites>
				<li>ShieldBelt</li>
				<li>PoweredArmor</li>
				<li>AdvancedFabrication</li>
			</researchPrerequisites>
