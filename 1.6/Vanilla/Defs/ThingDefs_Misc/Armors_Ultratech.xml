			<ComponentSpacer>6</ComponentSpacer>
			<Plasteel>200</Plasteel>
			<Hyperweave>50</Hyperweave>
			<BroadshieldCore MayRequire="Ludeon.Rimworld.Royalty">1</BroadshieldCore>
		</costList> -->
		<apparel>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>UltraMarine/ultra_armor_Helmet</wornGraphicPath>
			<blocksAddedPartWoundGraphics>true</blocksAddedPartWoundGraphics>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li></li>
			</tags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<soundWear>Wear_PowerArmor</soundWear>
			<soundRemove>Remove_PowerArmor</soundRemove>
		</apparel>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
		</thingSetMakerTags>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
