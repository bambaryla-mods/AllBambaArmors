<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the 1.7 (Waylith, .NET 10) assembly. The 1.6 DLL in 1.6/VEF/Assemblies is a frozen net472 build. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>AllBambaArmors</RootNamespace>
    <AssemblyName>AllBambaArmors</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>..\..\1.7\VEF\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <RimWorldDir>$(MSBuildThisFileDirectory)..\..\..\..</RimWorldDir>
    <WorkshopDir>$(RimWorldDir)\..\..\workshop\content\294100</WorkshopDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VEF">
      <HintPath>$(WorkshopDir)\2023507013\1.7\Assemblies\VEF.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(WorkshopDir)\2009463077\1.6\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
